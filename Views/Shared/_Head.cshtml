<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Registro Asistencia por QR</title>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📱</text></svg>">

<!-- Preload fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<!-- Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.js">
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Styles - Orden de carga optimizado -->
<!-- 1. Variables base (colores, espaciado, tipografía) -->
<link href="~/css/variables.css" rel="stylesheet" />
<!-- 2. Sistema de temas (toggle, transiciones) -->
<link href="~/css/theme-system.css" rel="stylesheet" />
<!-- 3. Utilidades (helpers, components safe) -->
<link href="~/css/utilities.css" rel="stylesheet" />
<!-- 4. Iconos -->
<link href="~/css/icon-utilities.css" rel="stylesheet" />
<!-- 5. Estilos específicos (se refactorizarán después) -->
<link href="~/css/styles.css" rel="stylesheet" />
<link href="~/css/modern-ui.css" rel="stylesheet" />
<link href="~/css/responsive-nav.css" rel="stylesheet" />
<link href="~/css/mobile-enhancements.css" rel="stylesheet" />
<link href="~/css/mobile-navbar-fix.css" rel="stylesheet" />

<!-- Theme Initialization Script (inline para evitar flash) -->
<script>
    // Cargar tema antes de que se renderice el contenido
    (function() {
        const theme = localStorage.getItem('user-theme-preference') ||
                     (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('theme-loading');
    })();
</script>

<!-- Meta tags -->
<meta name="theme-color" content="#0ea5e9">
<meta name="description" content="Sistema de asistencia inteligente con QR avanzado">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="format-detection" content="telephone=no">
