@{
    var userInitials = "";
    if (!string.IsNullOrEmpty(User.Identity.Name))
    {
        var names = User.Identity.Name.Split(' ');
        userInitials = names.Length >= 2 ?
            $"{names[0][0]}{names[1][0]}" :
            names[0].Substring(0, Math.Min(2, names[0].Length));
    }
}

<!-- Brand -->
<div class="header-brand">
    <a href="/" class="brand-link">
        <i data-lucide="graduation-cap" class="brand-icon"></i>
        <span class="brand-text">Registro QR</span>
    </a>
</div>

<!-- Desktop Navigation - SIMPLIFIED -->
<nav class="desktop-nav">
    <div class="nav-group nav-primary">
        <a href="/" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i data-lucide="home"></i>
            <span>Inicio</span>
        </a>

        <a href="/dashboard" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
        </a>

        <a href="/workflow/mis-clases" class="nav-item">
            <i data-lucide="calendar-days"></i>
            <span>Mis Clases</span>
        </a>

        <a href="/alumnos" class="nav-item">
            <i data-lucide="users"></i>
            <span>Estudiantes</span>
        </a>

        <a href="/asistencias" class="nav-item">
            <i data-lucide="clipboard-check"></i>
            <span>Asistencias</span>
        </a>

        <a href="/docente/scanner" class="nav-item scanner-highlight">
            <i data-lucide="scan"></i>
            <span>Escanear</span>
        </a>
    </div>

    <div class="nav-group nav-secondary">
        @if (User.IsInRole("Administrador"))
        {
            <a href="/usuarios" class="nav-item admin-highlight">
                <i data-lucide="shield-check"></i>
                <span>Admin</span>
            </a>
        }

        <a href="/ayuda" class="nav-item">
            <i data-lucide="help-circle"></i>
            <span>Ayuda</span>
        </a>
    </div>
</nav>

<!-- User Info & Actions -->
<div class="header-actions">
    <!-- Theme Toggle Button -->
    <button class="theme-toggle" id="themeToggle" title="Cambiar modo de color" aria-label="Cambiar tema">
        <i data-lucide="moon" class="theme-toggle-icon icon-moon"></i>
        <i data-lucide="sun" class="theme-toggle-icon icon-sun"></i>
    </button>

    <!-- Desktop User Info Simple -->
    <div class="desktop-user-info">
        <div class="user-avatar">
            <span>@userInitials.ToUpper()</span>
        </div>
        <div class="user-details">
            <span class="user-role @(User.IsInRole("Administrador") ? "admin" : "docente")">
                @(User.IsInRole("Administrador") ? "ADMIN" : "DOCENTE")
            </span>
            <span class="user-name">@User.Identity.Name</span>
        </div>
    </div>

    <!-- Desktop Logout Button -->
    <form method="post" action="/logout" id="desktopLogoutForm" class="desktop-logout">
        @Html.AntiForgeryToken()
        <button type="button" class="desktop-logout-btn" onclick="confirmLogout('desktop')" title="Cerrar Sesión">
            <i data-lucide="log-out"></i>
            <span class="logout-text">Cerrar Sesión</span>
        </button>
    </form>

    <!-- Mobile Menu Button -->
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Abrir menú">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
    </button>
</div>

<!-- Mobile Navigation - VENTANA FLOTANTE SIN SCROLL -->
<nav class="mobile-nav" id="mobileNav">
    <!-- Header del drawer con botón cerrar -->
    <div class="mobile-nav-header">
        <div class="mobile-nav-header-content">
            <div class="brand-icon-mobile">
                <i data-lucide="graduation-cap"></i>
            </div>
            <span class="mobile-nav-title">Menú</span>
        </div>
        <button class="mobile-nav-close" id="mobileNavClose" aria-label="Cerrar menú">
            <i data-lucide="x"></i>
        </button>
    </div>

    <div class="mobile-nav-content">
        <!-- User Profile -->
        <div class="mobile-user-profile">
            <div class="user-avatar">
                <span>@userInitials.ToUpper()</span>
            </div>
            <div class="user-details">
                <h3>@User.Identity.Name</h3>
                <p>@(User.IsInRole("Administrador") ? "Administrador" : "Docente")</p>
            </div>
        </div>

        <!-- Menu Items Compacto -->
        <div class="mobile-menu-section">
            <h4>Navegación</h4>
            <a href="/" class="mobile-nav-item">
                <i data-lucide="home"></i>
                <span>Inicio</span>
            </a>
            <a href="/dashboard" class="mobile-nav-item">
                <i data-lucide="layout-dashboard"></i>
                <span>Dashboard</span>
            </a>
            <a href="/workflow/mis-clases" class="mobile-nav-item">
                <i data-lucide="calendar-days"></i>
                <span>Mis Clases</span>
            </a>
            <a href="/docente/cursos" class="mobile-nav-item">
                <i data-lucide="book-open"></i>
                <span>Mis Cursos</span>
            </a>
            <a href="/alumnos" class="mobile-nav-item">
                <i data-lucide="users"></i>
                <span>Estudiantes</span>
            </a>
            <a href="/workflow/qr-students" class="mobile-nav-item">
                <i data-lucide="smartphone"></i>
                <span>QR Estudiantes</span>
            </a>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div class="mobile-menu-section">
                <h4>Admin</h4>
                <a href="/usuarios" class="mobile-nav-item admin">
                    <i data-lucide="shield-check"></i>
                    <span>Gestión Usuarios</span>
                </a>
            </div>
        }

        <div class="mobile-menu-section" style="margin-top: auto;">
            <button class="mobile-nav-item theme-toggle" id="mobileThemeToggle" title="Cambiar tema">
                <i data-lucide="moon" class="icon-moon"></i>
                <i data-lucide="sun" class="icon-sun"></i>
                <span class="theme-toggle-text">Modo Oscuro</span>
            </button>
            <a href="/ayuda" class="mobile-nav-item">
                <i data-lucide="help-circle"></i>
                <span>Ayuda</span>
            </a>
            <form method="post" action="/logout" id="mobileLogoutForm" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="button" class="mobile-nav-item logout" onclick="confirmLogout('mobile')">
                    <i data-lucide="log-out"></i>
                    <span>Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </div>
</nav>

<!-- Mobile Overlay -->
<div class="mobile-overlay" id="mobileOverlay"></div>

<!-- BOTTOM TAB NAVIGATION (Mobile Only) -->
<nav class="bottom-tab-nav">
    <a href="/" class="bottom-tab-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
        <i data-lucide="home"></i>
        <span>Inicio</span>
    </a>
    <a href="/dashboard" class="bottom-tab-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
        <i data-lucide="layout-dashboard"></i>
        <span>Panel</span>
    </a>
    <a href="/docente/scanner" class="bottom-tab-item scanner-tab">
        <i data-lucide="scan"></i>
        <span>Escanear</span>
    </a>
    <a href="/asistencias" class="bottom-tab-item">
        <i data-lucide="clipboard-check"></i>
        <span>Asistencias</span>
    </a>
    <button type="button" class="bottom-tab-item menu-tab" id="bottomMenuBtn">
        <i data-lucide="menu"></i>
        <span>Menú</span>
    </button>
</nav>
