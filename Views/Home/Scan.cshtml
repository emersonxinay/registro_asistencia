@{
    ViewData["Title"] = "Registro de Asistencia";
    ViewData["Subtitle"] = $"Clase {ViewBag.ClaseId}";
}

<div class="scan-container">
    <!-- QR Scanner Section -->
    <div class="scanner-section">
        <div class="card">
            <div class="card-header text-center">
                <h2 class="card-title">Escanear QR</h2>
                <p class="card-description">Activa la cámara para escanear</p>
            </div>

            <div class="scanner-controls">
                <button id="startScanBtn" class="btn btn-primary">
                    <i data-lucide="camera" class="btn-icon"></i>
                    Activar Cámara
                </button>
                <button id="stopScanBtn" class="btn btn-danger" style="display: none;">
                    <i data-lucide="x-circle" class="btn-icon"></i>
                    Cerrar Cámara
                </button>
            </div>

            <div id="scannerContainer" style="display: none;">
                <video id="qrVideo" playsinline></video>
                <div class="scanner-overlay">
                    <div class="scanner-frame"></div>
                    <p class="scanner-help">Apunta al código QR</p>
                </div>
                <button id="closeScannerBtn" class="btn-close-scanner">
                    <i data-lucide="x" class="close-icon"></i>
                </button>
            </div>

            <div id="scanStatus" class="scan-feedback"></div>
        </div>
    </div>

    <!-- Manual Entry Section -->
    <div class="manual-section">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="card-title">Registro Manual</h3>
                <p class="card-description">Ingresa tu ID</p>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-authenticated">
                    <div class="auth-info">
                        <i data-lucide="user-check" class="auth-icon"></i>
                        <div>
                            <p class="auth-name">@User.Identity.Name</p>
                            <p class="auth-note">Registro automático disponible</p>
                        </div>
                    </div>
                    <button id="autoRegisterBtn" class="btn btn-success" onclick="registrarAutomatico()">
                        <i data-lucide="zap" class="btn-icon"></i>
                        Registrar Automáticamente
                    </button>
                    <div class="auth-separator"><span>o</span></div>
                </div>
            }

            <form id="asistenciaForm">
                <div class="form-group">
                    <label class="form-label" for="alumnoId">ID del Alumno</label>
                    <input type="number" id="alumnoId" name="alumnoId" class="form-input" min="1" required
                           placeholder="Ingresa tu ID" autofocus>
                </div>

                <button type="submit" class="btn btn-primary btn-full">Marcar Asistencia</button>
            </form>

            <div id="mensaje"></div>

            <div class="qr-info">
                <p><strong>Clase:</strong> @ViewBag.ClaseId</p>
                <p class="small-text">Token de seguridad activo</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/qr-scanner@1.4.2/qr-scanner.umd.min.js"></script>
<script>
    let currentNonce = "@ViewBag.Nonce";
    const claseId = @ViewBag.ClaseId;
    let qrScanner = null;
    let isScanning = false;
    let audioContext = null;

    async function initAudio() {
        try {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        } catch (e) {
            console.log('Audio no disponible');
        }
    }

    function playSound(success = true) {
        if (!audioContext) return;
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        oscillator.frequency.setValueAtTime(success ? 800 : 400, audioContext.currentTime);
        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.3);
    }

    function showScanStatus(message, isSuccess = true, isScanning = false) {
        const statusDiv = document.getElementById('scanStatus');
        statusDiv.className = `scan-feedback ${isSuccess ? 'success' : 'error'} ${isScanning ? 'scanning' : ''}`;
        statusDiv.innerHTML = `
            <i data-lucide="${isSuccess ? 'check-circle' : 'x-circle'}" class="status-icon"></i>
            <span>${message}</span>
        `;
        if (window.lucide) lucide.createIcons();
        if (!isScanning) {
            setTimeout(() => {
                statusDiv.innerHTML = '';
                statusDiv.className = 'scan-feedback';
            }, 5000);
        }
    }

    async function renovarNonce() {
        const r = await fetch(`/api/clases/${claseId}/qr`);
        if (!r.ok) throw new Error('No se pudo renovar token');
        const j = await r.json();
        const parts = (j.url || '').split('nonce=');
        if (parts.length < 2) throw new Error('URL sin nonce');
        currentNonce = parts[1];
        return j;
    }

    async function processQRCode(qrData) {
        if (!qrData || qrData.trim() === '') return;
        showScanStatus('Procesando código QR...', true, false);
        playSound(true);

        if (qrScanner) {
            await qrScanner.stop();
            isScanning = false;
            toggleScannerUI(false);
        }

        try {
            let extractedNonce = currentNonce;
            if (qrData.includes('nonce=')) {
                const parts = qrData.split('nonce=');
                if (parts.length >= 2) {
                    extractedNonce = parts[1].split('&')[0];
                    currentNonce = extractedNonce;
                }
            }

            const alumnoIdInput = document.getElementById('alumnoId');
            const alumnoId = alumnoIdInput.value;

            if (!alumnoId) {
                showScanStatus('Por favor ingresa tu ID primero', false);
                playSound(false);
                return;
            }

            const response = await fetch('/api/asistencias/alumno-scan', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    alumnoId: parseInt(alumnoId),
                    claseId: claseId,
                    nonce: extractedNonce
                })
            });

            let result;
            try {
                result = await response.json();
            } catch (jsonError) {
                throw new Error('Respuesta inválida del servidor');
            }

            if (response.ok) {
                showScanStatus(result.mensaje || '¡Asistencia registrada!', true);
                playSound(true);
                document.getElementById('asistenciaForm').reset();
                const mensajeDiv = document.getElementById('mensaje');
                mensajeDiv.innerHTML = `<div class="status status-success">${result.mensaje || 'Asistencia registrada'}</div>`;
            } else {
                throw new Error(result.message || result.mensaje || 'Error al registrar');
            }
        } catch (error) {
            showScanStatus(`Error: ${error.message}`, false);
            playSound(false);
        }
    }

    function toggleScannerUI(scanning) {
        const startBtn = document.getElementById('startScanBtn');
        const stopBtn = document.getElementById('stopScanBtn');
        const container = document.getElementById('scannerContainer');

        if (scanning) {
            startBtn.style.display = 'none';
            stopBtn.style.display = 'inline-flex';
            container.style.display = 'block';
            showScanStatus('Escáner activo', true, true);
        } else {
            startBtn.style.display = 'inline-flex';
            stopBtn.style.display = 'none';
            container.style.display = 'none';
        }
    }

    async function startScanner() {
        if (isScanning) return;
        try {
            await initAudio();
            const videoElement = document.getElementById('qrVideo');
            qrScanner = new QrScanner(
                videoElement,
                result => processQRCode(result.data),
                {
                    onDecodeError: error => {},
                    highlightScanRegion: true,
                    highlightCodeOutline: true,
                    maxScansPerSecond: 5
                }
            );
            await qrScanner.start();
            isScanning = true;
            toggleScannerUI(true);
        } catch (error) {
            showScanStatus(`Error: ${error.message}`, false);
            playSound(false);
        }
    }

    async function stopScanner() {
        if (!isScanning || !qrScanner) return;
        try {
            await qrScanner.stop();
            isScanning = false;
            toggleScannerUI(false);
            showScanStatus('Escáner detenido', true);
        } catch (error) {
            console.error('Error:', error);
        }
    }

    async function marcarAsistencia(reintentado = false) {
        const alumnoId = document.getElementById('alumnoId').value;
        const mensajeDiv = document.getElementById('mensaje');

        if (!alumnoId) {
            mensajeDiv.innerHTML = '<div class="status status-error">Ingresa tu ID</div>';
            return;
        }

        try {
            const response = await fetch('/api/asistencias/alumno-scan', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    alumnoId: parseInt(alumnoId),
                    claseId: claseId,
                    nonce: currentNonce
                })
            });

            let result;
            try {
                result = await response.json();
            } catch (jsonError) {
                throw new Error('Respuesta inválida');
            }

            if (response.ok) {
                mensajeDiv.innerHTML = `<div class="status status-success">${result.mensaje || 'Asistencia registrada'}</div>`;
                document.getElementById('asistenciaForm').reset();
                playSound(true);
            } else {
                throw new Error(result.message || result.mensaje || 'Error al registrar');
            }
        } catch (error) {
            if (!reintentado && /nonce/i.test(error.message)) {
                try {
                    await renovarNonce();
                    await marcarAsistencia(true);
                    return;
                } catch {
                    mensajeDiv.innerHTML = '<div class="status status-error">QR expiró. Reintenta.</div>';
                    return;
                }
            }
            mensajeDiv.innerHTML = `<div class="status status-error">Error: ${error.message}</div>`;
            playSound(false);
        }
    }

    document.getElementById('startScanBtn').addEventListener('click', startScanner);
    document.getElementById('stopScanBtn').addEventListener('click', stopScanner);
    document.getElementById('asistenciaForm').addEventListener('submit', (e) => {
        e.preventDefault();
        marcarAsistencia(false);
    });

    window.addEventListener('beforeunload', () => {
        if (qrScanner) qrScanner.destroy();
    });

    async function registrarAutomatico() {
        @if (User.Identity?.IsAuthenticated == true)
        {
            <text>
            try {
                showScanStatus('Procesando...', true, false);
                const response = await fetch('/api/asistencias/alumno-scan-auto', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({claseId: claseId, nonce: currentNonce})
                });

                let result;
                try {
                    result = await response.json();
                } catch (jsonError) {
                    throw new Error('Respuesta inválida');
                }

                if (response.ok) {
                    showScanStatus(result.mensaje || '¡Registrado!', true);
                    playSound(true);
                    const mensajeDiv = document.getElementById('mensaje');
                    mensajeDiv.innerHTML = `<div class="status status-success">${result.mensaje || 'Registrado'}</div>`;
                    if (result.studentInfo) {
                        const info = result.studentInfo;
                        mensajeDiv.innerHTML += `<div class="student-details"><p><strong>Estudiante:</strong> ${info.nombre}</p><p><strong>ID:</strong> ${info.id}</p></div>`;
                    }
                } else {
                    throw new Error(result.message || result.mensaje || 'Error');
                }
            } catch (error) {
                showScanStatus(`Error: ${error.message}`, false);
                playSound(false);
            }
            </text>
        }
        else
        {
            <text>
            showScanStatus('Se requiere autenticación', false);
            playSound(false);
            </text>
        }
    }

    (async () => {
        try {
            await renovarNonce();
        } catch(_) {}
    })();
</script>
}

<style>
    /* CRITICAL: Mobile viewport fix */
    html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden !important;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* Container - Mobile First */
    .scan-container {
        width: 100%;
        max-width: 100vw;
        padding: 0.5rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        overflow-x: hidden;
    }

    /* Sections */
    .scanner-section,
    .manual-section {
        width: 100%;
        max-width: 100%;
        background: white;
        border-radius: 10px;
        padding: 0.875rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb;
        overflow: hidden;
    }

    .card {
        width: 100%;
        max-width: 100%;
    }

    /* Headers */
    .card-header {
        margin-bottom: 0.875rem;
        text-align: center;
    }

    .card-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 0.375rem 0;
    }

    .card-description {
        font-size: 0.8125rem;
        color: #6b7280;
        margin: 0;
    }

    /* Scanner Controls */
    .scanner-controls {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        margin: 0.75rem 0;
        width: 100%;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 11px 18px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 0.9375rem;
        width: 100%;
        min-height: 44px;
        cursor: pointer;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .btn-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.25);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        margin-top: 0.5rem;
    }

    .btn-full {
        width: 100%;
    }

    /* Scanner Container - COMPACT FOR MOBILE */
    #scannerContainer {
        position: relative;
        width: 100%;
        max-width: 260px;
        height: 260px;
        margin: 0.75rem auto;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
    }

    #qrVideo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        pointer-events: none;
    }

    .scanner-frame {
        width: 130px;
        height: 130px;
        border: 3px solid #22c55e;
        border-radius: 10px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { border-color: #22c55e; opacity: 1; }
        50% { border-color: #16a34a; opacity: 0.8; }
    }

    .scanner-help {
        margin-top: 0.625rem;
        color: white;
        background: rgba(0, 0, 0, 0.85);
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        text-align: center;
    }

    /* Feedback */
    .scan-feedback {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem;
        margin: 0.75rem 0;
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .scan-feedback.success {
        background: #dcfce7;
        color: #166534;
        border: 2px solid #bbf7d0;
    }

    .scan-feedback.error {
        background: #fee2e2;
        color: #dc2626;
        border: 2px solid #fecaca;
    }

    .scan-feedback.scanning {
        background: #dbeafe;
        color: #1e40af;
        border: 2px solid #bfdbfe;
    }

    .status-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    /* User Auth */
    .user-authenticated {
        background: #f0f9ff;
        border: 2px solid #0ea5e9;
        border-radius: 10px;
        padding: 0.875rem;
        margin-bottom: 1rem;
    }

    .auth-info {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        margin-bottom: 0.75rem;
    }

    .auth-icon {
        width: 20px;
        height: 20px;
        color: #0ea5e9;
        flex-shrink: 0;
    }

    .auth-name {
        font-weight: 600;
        color: #0c4a6e;
        margin: 0;
        font-size: 0.875rem;
    }

    .auth-note {
        font-size: 0.75rem;
        color: #0369a1;
        margin: 0;
    }

    .auth-separator {
        text-align: center;
        margin: 0.75rem 0;
        position: relative;
        height: 1px;
        background: #cbd5e1;
    }

    .auth-separator span {
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        background: #f0f9ff;
        padding: 0 10px;
        font-size: 0.75rem;
        color: #64748b;
    }

    /* Forms */
    .form-group {
        margin-bottom: 0.875rem;
        width: 100%;
    }

    .form-label {
        display: block;
        margin-bottom: 0.375rem;
        color: #374151;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 16px;
        min-height: 44px;
        box-sizing: border-box;
    }

    .form-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    /* Info */
    .qr-info {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        text-align: center;
        margin-top: 0.875rem;
        font-size: 0.8125rem;
        color: #6b7280;
    }

    .qr-info p {
        margin: 0.25rem 0;
    }

    .small-text {
        font-size: 0.75rem;
    }

    /* Status Messages */
    #mensaje {
        margin-top: 0.75rem;
    }

    .status {
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 500;
        margin: 0.5rem 0;
    }

    .status-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .status-error {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .student-details {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 0.75rem;
        margin-top: 0.5rem;
        font-size: 0.8125rem;
    }

    .student-details p {
        margin: 0.25rem 0;
        color: #4b5563;
    }

    /* Tablet & Desktop */
    @@media (min-width: 768px) {
        .scan-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
            padding: 1.5rem;
        }

        .scanner-section,
        .manual-section {
            padding: 1.5rem;
        }

        .card-title {
            font-size: 1.5rem;
        }

        .card-description {
            font-size: 1rem;
        }

        .scanner-controls {
            flex-direction: row;
            justify-content: center;
        }

        .btn {
            width: auto;
            min-width: 150px;
        }

        #scannerContainer {
            max-width: 320px;
            height: 320px;
        }

        .scanner-frame {
            width: 160px;
            height: 160px;
        }

        .scanner-help {
            font-size: 0.875rem;
        }
    }

    @@media (min-width: 1024px) {
        #scannerContainer {
            max-width: 360px;
            height: 360px;
        }

        .scanner-frame {
            width: 180px;
            height: 180px;
        }
    }
</style>
