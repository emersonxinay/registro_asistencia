@{
    ViewData["Title"] = "Registrar Asistencia";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

@section Styles {
    <style>
        /* Page Container - MOBILE OPTIMIZED */
        .scan-page {
            min-height: calc(100vh - var(--header-height));
            padding: 12px;
            max-width: 100%;
            margin: 0 auto;
            padding-bottom: max(88px, calc(var(--bottom-nav-height, 0px) + 20px));
        }

        @@media (min-width: 640px) {
            .scan-page {
                padding: 16px;
                max-width: 640px;
            }
        }

        @@media (min-width: 768px) {
            .scan-page {
                padding: 20px;
                max-width: 720px;
            }
        }

        @@media (min-width: 1024px) {
            .scan-page {
                padding: 24px;
                max-width: 800px;
                padding-bottom: 24px;
            }
        }

        /* Class Info Badge - MOBILE OPTIMIZED */
        .class-info-badge {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.12), rgba(118, 75, 162, 0.08));
            border: 2px solid var(--accent-color);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15);
        }

        @@media (min-width: 640px) {
            .class-info-badge {
                border-radius: 16px;
                padding: 14px 16px;
                margin-bottom: 20px;
                gap: 12px;
                align-items: center;
            }
        }

        .class-info-icon {
            width: 36px;
            height: 36px;
            background: var(--gradient-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            flex-shrink: 0;
        }

        @@media (min-width: 640px) {
            .class-info-icon {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                font-size: 18px;
            }
        }

        .class-info-text {
            flex: 1;
            min-width: 0;
        }

        .class-info-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
            line-height: 1.3;
            /* Permitir que el texto se ajuste en dos líneas en móvil */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @@media (min-width: 640px) {
            .class-info-title {
                font-size: 15px;
                -webkit-line-clamp: 1;
                white-space: nowrap;
            }
        }

        .class-info-name {
            font-size: 11px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        @@media (min-width: 640px) {
            .class-info-name {
                font-size: 12px;
            }
        }

        .class-id-badge {
            background: var(--accent-color);
            color: white;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 10px;
            font-weight: 700;
            flex-shrink: 0;
            white-space: nowrap;
            align-self: flex-start;
            margin-top: 2px;
        }

        @@media (min-width: 640px) {
            .class-id-badge {
                padding: 6px 12px;
                border-radius: 12px;
                font-size: 11px;
                align-self: center;
                margin-top: 0;
            }
        }

        /* Cards - MOBILE OPTIMIZED */
        .card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 12px;
            box-shadow: var(--shadow-sm);
        }

        @@media (min-width: 640px) {
            .card {
                border-radius: 16px;
                padding: 16px;
                margin-bottom: 14px;
            }
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
        }

        @@media (min-width: 640px) {
            .card-header {
                gap: 10px;
                margin-bottom: 14px;
                padding-bottom: 12px;
            }
        }

        .card-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            flex-shrink: 0;
        }

        @@media (min-width: 640px) {
            .card-icon {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                font-size: 18px;
            }
        }

        .card-title {
            flex: 1;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        @@media (min-width: 640px) {
            .card-title {
                font-size: 15px;
            }
        }

        .card-desc {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 10px;
            line-height: 1.4;
        }

        @@media (min-width: 640px) {
            .card-desc {
                font-size: 13px;
                margin-bottom: 12px;
            }
        }

        /* Instructions Card - MOBILE OPTIMIZED */
        .instructions-card {
            background: var(--bg-secondary);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 16px;
        }

        @@media (min-width: 640px) {
            .instructions-card {
                border-radius: 16px;
                padding: 20px;
                margin-bottom: 24px;
            }
        }

        .instructions-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border-color);
        }

        @@media (min-width: 640px) {
            .instructions-header {
                gap: 10px;
                font-size: 16px;
                margin-bottom: 16px;
                padding-bottom: 12px;
            }
        }

        .instructions-header i {
            color: var(--accent-color);
            font-size: 18px;
        }

        @@media (min-width: 640px) {
            .instructions-header i {
                font-size: 20px;
            }
        }

        .instructions-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        @@media (min-width: 640px) {
            .instructions-list {
                gap: 12px;
            }
        }

        .instruction-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px;
            background: var(--bg-primary);
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

        @@media (min-width: 640px) {
            .instruction-item {
                gap: 12px;
                padding: 12px;
                border-radius: 12px;
            }
        }

        .instruction-number {
            width: 28px;
            height: 28px;
            background: var(--gradient-primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            flex-shrink: 0;
        }

        .instruction-number i {
            font-size: 13px;
        }

        @@media (min-width: 640px) {
            .instruction-number {
                width: 32px;
                height: 32px;
                font-size: 14px;
            }

            .instruction-number i {
                font-size: 15px;
            }
        }

        .instruction-content {
            flex: 1;
            min-width: 0;
        }

        .instruction-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 3px;
        }

        @@media (min-width: 640px) {
            .instruction-title {
                font-size: 14px;
                margin-bottom: 4px;
            }
        }

        .instruction-desc {
            font-size: 11px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        @@media (min-width: 640px) {
            .instruction-desc {
                font-size: 12px;
            }
        }

        /* Auth Badge - MOBILE OPTIMIZED */
        .auth-badge {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.08));
            border: 2px solid rgba(16, 185, 129, 0.3);
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@media (min-width: 640px) {
            .auth-badge {
                border-radius: 12px;
                padding: 12px;
                margin-bottom: 14px;
                gap: 12px;
            }
        }

        .auth-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            flex-shrink: 0;
        }

        @@media (min-width: 640px) {
            .auth-avatar {
                width: 48px;
                height: 48px;
                font-size: 20px;
            }
        }

        .auth-info {
            flex: 1;
            min-width: 0;
        }

        .auth-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 3px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        @@media (min-width: 640px) {
            .auth-name {
                font-size: 14px;
                margin-bottom: 4px;
            }
        }

        .auth-status {
            font-size: 11px;
            color: #059669;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        @@media (min-width: 640px) {
            .auth-status {
                font-size: 12px;
            }
        }

        /* Buttons - MOBILE OPTIMIZED */
        .btn {
            width: 100%;
            padding: 12px 16px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            min-height: 48px;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        @@media (min-width: 640px) {
            .btn {
                padding: 14px 18px;
                border-radius: 12px;
                font-size: 15px;
                min-height: 52px;
            }
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn i {
            font-size: 16px;
            flex-shrink: 0;
        }

        @@media (min-width: 640px) {
            .btn i {
                font-size: 18px;
            }
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: var(--bg-tertiary);
            color: var(--text-primary);
            border: 2px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Form - MOBILE OPTIMIZED */
        .form-group {
            margin-bottom: 12px;
        }

        @@media (min-width: 640px) {
            .form-group {
                margin-bottom: 14px;
            }
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        @@media (min-width: 640px) {
            .form-label {
                font-size: 13px;
                margin-bottom: 8px;
            }
        }

        .form-input {
            width: 100%;
            padding: 12px;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            font-size: 16px;
            background: var(--bg-primary);
            color: var(--text-primary);
            transition: all 0.2s;
        }

        @@media (min-width: 640px) {
            .form-input {
                padding: 14px;
                border-radius: 12px;
            }
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px var(--focus-ring);
        }

        @@media (min-width: 640px) {
            .form-input:focus {
                box-shadow: 0 0 0 4px var(--focus-ring);
            }
        }

        /* Messages */
        .message {
            padding: 14px;
            border-radius: 12px;
            margin-top: 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            animation: slideIn 0.3s ease-out;
            border: 2px solid;
        }

        .message i {
            font-size: 20px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .message-text {
            flex: 1;
            font-size: 14px;
            line-height: 1.5;
        }

        .message-success {
            background: rgba(16, 185, 129, 0.1);
            border-color: rgba(16, 185, 129, 0.4);
            color: #059669;
        }

        .message-error {
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.4);
            color: #dc2626;
        }

        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Camera Fullscreen */
        .camera-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #000;
            z-index: 1000;
            flex-direction: column;
        }

        .camera-modal.active {
            display: flex;
        }

        .camera-header {
            padding: 16px;
            background: rgba(0,0,0,0.9);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: white;
        }

        .camera-title {
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .close-camera {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 20px;
        }

        .camera-viewport {
            flex: 1;
            position: relative;
        }

        #videoElement {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .scan-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 260px;
            height: 260px;
            border: 3px solid #10b981;
            border-radius: 24px;
            box-shadow: 0 0 0 9999px rgba(0,0,0,0.7);
            animation: scanPulse 2s infinite;
        }

        .scan-overlay.scanning {
            border-color: #f59e0b;
        }

        @@keyframes scanPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .scan-hint {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 12px 24px;
            border-radius: 24px;
            font-size: 14px;
            max-width: 90%;
            text-align: center;
        }

        /* Responsive */
        @@media (min-width: 640px) {
            .guest-buttons {
                flex-direction: row;
            }

            .btn {
                min-width: 0;
            }
        }

        /* iOS Safe Areas */
        @@supports (-webkit-touch-callout: none) {
            .header {
                padding-top: max(12px, env(safe-area-inset-top));
            }

            .content {
                padding-bottom: max(16px, env(safe-area-inset-bottom));
            }

            .card,
            .guest-card {
                backdrop-filter: blur(15px) !important;
                -webkit-backdrop-filter: blur(15px) !important;
            }
        }
    </style>
}

<!-- Scan Page Content -->
<div class="scan-page">
    <!-- Class Info Badge -->
    <div class="class-info-badge">
        <div class="class-info-icon">
            <i class="fas fa-qrcode"></i>
        </div>
        <div class="class-info-text">
            <div class="class-info-title" id="claseNombre">Cargando clase...</div>
            <div class="class-info-name">Registro de Asistencia</div>
        </div>
        <div class="class-id-badge">#@ViewBag.ClaseId</div>
    </div>

    <!-- Instrucciones - Siempre visible -->
    <div class="instructions-card">
        <div class="instructions-header">
            <i class="fas fa-question-circle"></i>
            <span>¿Cómo registrar tu asistencia?</span>
        </div>
        <div class="instructions-list">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="instruction-item">
                    <div class="instruction-number">1</div>
                    <div class="instruction-content">
                        <div class="instruction-title">Registro Rápido (Recomendado)</div>
                        <div class="instruction-desc">Usa el botón "Registrar Mi Asistencia Ahora" para un registro instantáneo con tu cuenta.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="instruction-item">
                    <div class="instruction-number">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <div class="instruction-content">
                        <div class="instruction-title">Tip: Crea una cuenta</div>
                        <div class="instruction-desc">Con una cuenta puedes registrar tu asistencia con un solo clic. Usa el botón de menú para ingresar o registrarte.</div>
                    </div>
                </div>
            }
            <div class="instruction-item">
                <div class="instruction-number">
                    @if (User.Identity?.IsAuthenticated == true) { <text>2</text> } else { <text>1</text> }
                </div>
                <div class="instruction-content">
                    <div class="instruction-title">Escanear QR del Profesor</div>
                    <div class="instruction-desc">Abre la cámara y escanea el código QR que muestra tu profesor en pantalla.</div>
                </div>
            </div>
            <div class="instruction-item">
                <div class="instruction-number">
                    @if (User.Identity?.IsAuthenticated == true) { <text>3</text> } else { <text>2</text> }
                </div>
                <div class="instruction-content">
                    <div class="instruction-title">Registro Manual</div>
                    <div class="instruction-desc">Ingresa tu ID de estudiante manualmente en el formulario de abajo.</div>
                </div>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Usuario autenticado -->
        <div class="auth-badge">
            <div class="auth-avatar">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="auth-info">
                <div class="auth-name">@User.Identity.Name</div>
                <div class="auth-status">
                    <i class="fas fa-check-circle"></i>
                    Registro automático disponible
                </div>
            </div>
        </div>

        <!-- Registro Automático -->
        <div class="card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <div class="card-title">Registro Rápido</div>
            </div>
            <div class="card-desc">
                <i class="fas fa-info-circle"></i> Registra tu asistencia con un solo clic usando tu cuenta
            </div>
            <button class="btn btn-success" id="autoRegisterBtn">
                <i class="fas fa-fingerprint"></i>
                <span>Registrar Mi Asistencia Ahora</span>
            </button>
        </div>
    }

    <!-- Escanear QR -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">
                <i class="fas fa-camera"></i>
            </div>
            <div class="card-title">Escanear Código QR</div>
        </div>
        <div class="card-desc">
            <i class="fas fa-info-circle"></i> Abre la cámara y escanea el código QR de la clase mostrado por el profesor
        </div>
        <button class="btn btn-primary" id="openCameraBtn">
            <i class="fas fa-qrcode"></i>
            <span>Abrir Cámara</span>
        </button>
    </div>

    <!-- Registro Manual -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">
                <i class="fas fa-keyboard"></i>
            </div>
            <div class="card-title">Registro Manual por ID</div>
        </div>
        <div class="card-desc">
            <i class="fas fa-info-circle"></i> Ingresa tu número de ID de estudiante para registrar tu asistencia manualmente
        </div>
        <form id="manualForm">
            <div class="form-group">
                <label class="form-label" for="studentId">
                    <i class="fas fa-id-card"></i>
                    ID de Estudiante
                </label>
                <input
                    type="number"
                    id="studentId"
                    class="form-input"
                    placeholder="Ej: 12345678"
                    required
                    min="1"
                    pattern="[0-9]*"
                    inputmode="numeric">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check-circle"></i>
                <span>Registrar Asistencia</span>
            </button>
        </form>
    </div>

    <!-- Messages -->
    <div id="messageArea"></div>
</div>

<!-- Camera Modal -->
<div class="camera-modal" id="cameraModal">
    <div class="camera-header">
        <div class="camera-title">
            <i class="fas fa-qrcode"></i>
            Escanear QR
        </div>
        <button class="close-camera" id="closeCameraBtn">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="camera-viewport">
        <video id="videoElement" playsinline autoplay></video>
        <div class="scan-overlay" id="scanOverlay"></div>
        <div class="scan-hint">
            <i class="fas fa-arrow-down"></i> Centra el código QR en el recuadro
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/qr-scanner@1.4.2/qr-scanner.umd.min.js"></script>
    <script>
        const claseId = @ViewBag.ClaseId;
        let currentNonce = "@ViewBag.Nonce";
        let qrScanner = null;

        // Cargar info clase
        async function loadClassInfo() {
            try {
                const res = await fetch(`/api/clases/${claseId}`);
                if (res.ok) {
                    const data = await res.json();
                    const name = data.nombreCompleto || `${data.asignatura || ''} - ${data.curso || ''}`.trim() || `Clase ${claseId}`;
                    document.getElementById('claseNombre').textContent = name;
                }
            } catch (e) {
                document.getElementById('claseNombre').textContent = `Clase ${claseId}`;
            }
        }

        // Mostrar mensaje
        function showMessage(text, type = 'error') {
            const area = document.getElementById('messageArea');
            const icon = type === 'success' ? 'check-circle' : 'exclamation-circle';
            area.innerHTML = `
                <div class="message message-${type}">
                    <i class="fas fa-${icon}"></i>
                    <div class="message-text">${text}</div>
                </div>
            `;
            setTimeout(() => area.innerHTML = '', 6000);
        }

        // Registro manual
        document.getElementById('manualForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const studentId = document.getElementById('studentId').value;

            try {
                const res = await fetch('/api/asistencias/alumno-scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        alumnoId: parseInt(studentId),
                        claseId,
                        nonce: currentNonce
                    })
                });

                const data = await res.json();

                if (res.ok) {
                    showMessage(`✅ ${data.mensaje || 'Asistencia registrada correctamente'}`, 'success');
                    document.getElementById('manualForm').reset();
                } else {
                    throw new Error(data.mensaje || 'Error al registrar asistencia');
                }
            } catch (error) {
                showMessage(`❌ ${error.message}`, 'error');
            }
        });

        // Registro automático
        document.getElementById('autoRegisterBtn')?.addEventListener('click', async () => {
            try {
                const res = await fetch('/api/asistencias/alumno-scan-auto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ claseId, nonce: currentNonce })
                });

                const data = await res.json();

                if (res.ok) {
                    showMessage(`✅ ${data.mensaje || 'Asistencia registrada correctamente'}`, 'success');
                } else {
                    throw new Error(data.mensaje || 'Error al registrar');
                }
            } catch (error) {
                showMessage(`❌ ${error.message}`, 'error');
            }
        });

        // Cámara QR
        const modal = document.getElementById('cameraModal');
        const video = document.getElementById('videoElement');
        const overlay = document.getElementById('scanOverlay');

        document.getElementById('openCameraBtn').addEventListener('click', async () => {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment' }
                });
                video.srcObject = stream;
                modal.classList.add('active');
                startScanning();
            } catch (error) {
                showMessage('❌ No se pudo acceder a la cámara. Verifica los permisos.', 'error');
            }
        });

        document.getElementById('closeCameraBtn').addEventListener('click', () => {
            closeCamera();
        });

        function closeCamera() {
            if (qrScanner) {
                qrScanner.stop();
                qrScanner = null;
            }
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
            modal.classList.remove('active');
        }

        function startScanning() {
            overlay.classList.add('scanning');
            qrScanner = new QrScanner(
                video,
                result => handleQRCode(result.data),
                {
                    onDecodeError: () => {},
                    highlightScanRegion: false,
                    highlightCodeOutline: false,
                    maxScansPerSecond: 5
                }
            );
            qrScanner.start();
        }

        async function handleQRCode(data) {
            overlay.classList.remove('scanning');
            closeCamera();

            const studentId = document.getElementById('studentId').value;
            if (!studentId) {
                showMessage('⚠️ Por favor ingresa tu ID de estudiante primero', 'error');
                return;
            }

            try {
                const res = await fetch('/api/asistencias/alumno-scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        alumnoId: parseInt(studentId),
                        claseId,
                        nonce: currentNonce
                    })
                });

                const result = await res.json();

                if (res.ok) {
                    showMessage(`✅ ${result.mensaje || 'Asistencia registrada'}`, 'success');
                } else {
                    throw new Error(result.mensaje || 'Error al registrar');
                }
            } catch (error) {
                showMessage(`❌ ${error.message}`, 'error');
            }
        }

        // Inicializar
        loadClassInfo();
    </script>
}
