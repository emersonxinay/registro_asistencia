@{
    ViewData["Title"] = "Registrar Asistencia";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

@section Styles {
    <style>
        /* DISEÑO RESPONSIVE - 100% EM/REM - SIN FIXED - DARK MODE COMPATIBLE */

        /* Variables adicionales para Scan (compatible con theme-system.css) */
        :root {
            --gradient-primary: linear-gradient(135deg,
                hsl(199, 89%, 48%),
                hsl(187, 95%, 43%));
            --accent-color: hsl(173, 80%, 40%);
            --focus-ring: hsla(173, 80%, 40%, 0.2);
        }

        [data-theme="dark"] {
            --gradient-primary: linear-gradient(135deg,
                hsl(199, 89%, 58%),
                hsl(187, 95%, 53%));
            --accent-color: hsl(173, 80%, 50%);
            --focus-ring: hsla(173, 80%, 50%, 0.3);
        }

        /* Page Container */
        .scan-page {
            width: 100%;
            max-width: 50rem;
            margin: 0 auto;
            padding: 1rem;
            padding-bottom: 2rem;
        }

        @@media(min-width: 48em) {
            .scan-page {
                padding: 1.5rem;
                padding-bottom: 2.5rem;
            }
        }

        @@media(min-width: 64em) {
            .scan-page {
                padding: 2rem;
                padding-bottom: 3rem;
            }
        }

        /* Class Info Badge */
        .class-info-badge {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.12), rgba(118, 75, 162, 0.08));
            border: 0.125rem solid var(--accent-color);
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 0.125rem 0.5rem rgba(102, 126, 234, 0.15);
        }

        @@media(min-width: 48em) {
            .class-info-badge {
                padding: 1rem 1.25rem;
                margin-bottom: 1.25rem;
            }
        }

        .class-info-icon {
            width: 2.25rem;
            height: 2.25rem;
            background: var(--gradient-primary);
            border-radius: 0.625rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.125rem;
            flex-shrink: 0;
        }

        @@media(min-width: 48em) {
            .class-info-icon {
                width: 2.5rem;
                height: 2.5rem;
                font-size: 1.25rem;
            }
        }

        .class-info-text {
            flex: 1;
            min-width: 0;
        }

        .class-info-title {
            font-size: 0.9375rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.25rem;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @@media(min-width: 40em) {
            .class-info-title {
                font-size: 1rem;
                -webkit-line-clamp: 1;
                white-space: nowrap;
            }
        }

        .class-info-name {
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        @@media(min-width: 40em) {
            .class-info-name {
                font-size: 0.8125rem;
            }
        }

        .class-id-badge {
            background: var(--accent-color);
            color: white;
            padding: 0.375rem 0.625rem;
            border-radius: 0.625rem;
            font-size: 0.6875rem;
            font-weight: 700;
            flex-shrink: 0;
            white-space: nowrap;
            align-self: flex-start;
            margin-top: 0.125rem;
        }

        @@media(min-width: 40em) {
            .class-id-badge {
                padding: 0.5rem 0.875rem;
                border-radius: 0.875rem;
                font-size: 0.75rem;
                align-self: center;
                margin-top: 0;
            }
        }

        /* Cards */
        .card {
            background: var(--bg-secondary);
            border: 0.0625rem solid var(--border-color);
            border-radius: 0.875rem;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: var(--shadow-sm);
        }

        @@media(min-width: 48em) {
            .card {
                padding: 1.25rem;
                margin-bottom: 1.25rem;
            }
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            margin-bottom: 0.875rem;
            padding-bottom: 0.75rem;
            border-bottom: 0.0625rem solid var(--border-color);
        }

        @@media(min-width: 40em) {
            .card-header {
                gap: 0.75rem;
                margin-bottom: 1rem;
                padding-bottom: 0.875rem;
            }
        }

        .card-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.75rem;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.125rem;
            flex-shrink: 0;
        }

        @@media(min-width: 40em) {
            .card-icon {
                width: 2.75rem;
                height: 2.75rem;
                border-radius: 0.875rem;
                font-size: 1.25rem;
            }
        }

        .card-title {
            flex: 1;
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        @@media(min-width: 40em) {
            .card-title {
                font-size: 1rem;
            }
        }

        .card-desc {
            font-size: 0.8125rem;
            color: var(--text-secondary);
            margin-bottom: 0.875rem;
            line-height: 1.4;
        }

        @@media(min-width: 40em) {
            .card-desc {
                font-size: 0.875rem;
                margin-bottom: 1rem;
            }
        }

        /* Instructions Card */
        .instructions-card {
            background: var(--bg-secondary);
            border: 0.0625rem solid var(--border-color);
            border-radius: 0.875rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        @@media(min-width: 48em) {
            .instructions-card {
                padding: 1.25rem;
                margin-bottom: 1.25rem;
            }
        }

        .instructions-header {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            font-size: 0.9375rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.875rem;
            padding-bottom: 0.75rem;
            border-bottom: 0.125rem solid var(--border-color);
        }

        @@media(min-width: 40em) {
            .instructions-header {
                gap: 0.75rem;
                font-size: 1rem;
                margin-bottom: 1rem;
                padding-bottom: 0.875rem;
            }
        }

        .instructions-header i {
            color: var(--accent-color);
            font-size: 1.25rem;
        }

        @@media(min-width: 40em) {
            .instructions-header i {
                font-size: 1.375rem;
            }
        }

        .instructions-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        @@media(min-width: 40em) {
            .instructions-list {
                gap: 0.875rem;
            }
        }

        .instruction-item {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 0.75rem;
            background: var(--bg-primary);
            border-radius: 0.75rem;
            border: 0.0625rem solid var(--border-color);
        }

        @@media(min-width: 40em) {
            .instruction-item {
                gap: 0.875rem;
                padding: 0.875rem;
                border-radius: 0.875rem;
            }
        }

        .instruction-number {
            width: 2rem;
            height: 2rem;
            background: var(--gradient-primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.875rem;
            flex-shrink: 0;
        }

        .instruction-number i {
            font-size: 0.9375rem;
        }

        @@media(min-width: 40em) {
            .instruction-number {
                width: 2.25rem;
                height: 2.25rem;
                font-size: 0.9375rem;
            }

            .instruction-number i {
                font-size: 1rem;
            }
        }

        .instruction-content {
            flex: 1;
            min-width: 0;
        }

        .instruction-title {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.25rem;
        }

        @@media(min-width: 40em) {
            .instruction-title {
                font-size: 0.9375rem;
                margin-bottom: 0.3125rem;
            }
        }

        .instruction-desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        @@media(min-width: 40em) {
            .instruction-desc {
                font-size: 0.8125rem;
            }
        }

        /* Auth Badge */
        .auth-badge {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.08));
            border: 0.125rem solid rgba(16, 185, 129, 0.3);
            border-radius: 0.75rem;
            padding: 0.75rem;
            margin-bottom: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        @@media(min-width: 40em) {
            .auth-badge {
                border-radius: 0.875rem;
                padding: 0.875rem;
                margin-bottom: 1rem;
                gap: 0.875rem;
            }
        }

        .auth-avatar {
            width: 3rem;
            height: 3rem;
            background: linear-gradient(135deg, var(--success), hsl(142, 71%, 35%));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        @@media(min-width: 40em) {
            .auth-avatar {
                width: 3.25rem;
                height: 3.25rem;
                font-size: 1.375rem;
            }
        }

        .auth-info {
            flex: 1;
            min-width: 0;
        }

        .auth-name {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.25rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        @@media(min-width: 40em) {
            .auth-name {
                font-size: 0.9375rem;
                margin-bottom: 0.3125rem;
            }
        }

        .auth-status {
            font-size: 0.75rem;
            color: var(--success);
            display: flex;
            align-items: center;
            gap: 0.3125rem;
        }

        @@media(min-width: 40em) {
            .auth-status {
                font-size: 0.8125rem;
            }
        }

        /* Buttons */
        .btn {
            width: 100%;
            padding: 0.875rem 1.125rem;
            border: none;
            border-radius: 0.75rem;
            font-size: 0.9375rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.625rem;
            transition: all 0.2s;
            min-height: 3.25rem;
            text-decoration: none;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }

        @@media(min-width: 48em) {
            .btn {
                padding: 1rem 1.25rem;
                font-size: 1rem;
                min-height: 3.5rem;
            }
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn i {
            font-size: 1.125rem;
            flex-shrink: 0;
        }

        @@media(min-width: 40em) {
            .btn i {
                font-size: 1.25rem;
            }
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 0.25rem 0.75rem rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: var(--bg-tertiary);
            color: var(--text-primary);
            border: 0.125rem solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--success), hsl(142, 71%, 35%));
            color: white;
            box-shadow: 0 0.25rem 0.75rem hsla(142, 71%, 45%, 0.4);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Form */
        .form-group {
            margin-bottom: 0.875rem;
        }

        @@media(min-width: 48em) {
            .form-group {
                margin-bottom: 1rem;
            }
        }

        .form-label {
            display: flex;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            align-items: center;
            gap: 0.5rem;
        }

        @@media(min-width: 48em) {
            .form-label {
                font-size: 0.9375rem;
                margin-bottom: 0.625rem;
            }
        }

        .form-input {
            width: 100%;
            padding: 0.875rem;
            border: 0.125rem solid var(--border-color);
            border-radius: 0.75rem;
            font-size: 1rem;
            background: var(--bg-primary);
            color: var(--text-primary);
            transition: all 0.2s;
        }

        @@media(min-width: 48em) {
            .form-input {
                padding: 1rem;
                font-size: 1.0625rem;
            }
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.25rem var(--focus-ring);
        }

        /* Messages */
        .message {
            padding: 1rem;
            border-radius: 0.875rem;
            margin-top: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            animation: slideIn 0.3s ease-out;
            border: 0.125rem solid;
        }

        .message i {
            font-size: 1.375rem;
            margin-top: 0.125rem;
            flex-shrink: 0;
        }

        .message-text {
            flex: 1;
            font-size: 0.9375rem;
            line-height: 1.5;
        }

        .message-text small {
            display: block;
            margin-top: 0.5rem;
            opacity: 0.8;
            font-size: 0.8125rem;
        }

        .message-success {
            background: hsla(142, 71%, 45%, 0.1);
            border-color: hsla(142, 71%, 45%, 0.4);
            color: var(--success);
        }

        .message-error {
            background: hsla(0, 84%, 60%, 0.1);
            border-color: hsla(0, 84%, 60%, 0.4);
            color: var(--danger);
        }

        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(-0.625rem); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes slideOut {
            from { opacity: 1; transform: translateY(0); }
            to { opacity: 0; transform: translateY(-0.625rem); }
        }

        /* Estilos adicionales de mensajes */
        .message-loading {
            background: hsla(204, 94%, 60%, 0.1);
            border-color: hsla(204, 94%, 60%, 0.4);
            color: var(--info);
        }

        .message-warning {
            background: hsla(38, 92%, 50%, 0.1);
            border-color: hsla(38, 92%, 50%, 0.4);
            color: var(--warning);
        }

        .message-info {
            background: hsla(204, 94%, 60%, 0.1);
            border-color: hsla(204, 94%, 60%, 0.4);
            color: var(--info);
        }

        [data-theme="dark"] .message-loading,
        [data-theme="dark"] .message-info {
            color: hsl(204, 94%, 70%);
        }

        [data-theme="dark"] .message-warning {
            color: hsl(38, 92%, 60%);
        }

        [data-theme="dark"] .message-success {
            background: hsla(142, 71%, 45%, 0.15);
            border-color: hsla(142, 71%, 45%, 0.5);
            color: hsl(142, 71%, 55%);
        }

        [data-theme="dark"] .message-error {
            background: hsla(0, 84%, 60%, 0.15);
            border-color: hsla(0, 84%, 60%, 0.5);
            color: hsl(0, 84%, 70%);
        }

        /* Camera Modal - Mantiene fixed porque es overlay full-screen */
        .camera-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: hsl(0, 0%, 0%);
            z-index: 1000;
            flex-direction: column;
        }

        .camera-modal.active {
            display: flex;
        }

        .camera-header {
            padding: 1rem;
            background: rgba(0,0,0,0.9);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: white;
        }

        .camera-title {
            font-size: 1.125rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }

        .close-camera {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.375rem;
        }

        .camera-viewport {
            flex: 1;
            position: relative;
        }

        #videoElement {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .scan-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 16.25rem;
            height: 16.25rem;
            border: 0.1875rem solid var(--success);
            border-radius: 1.5rem;
            box-shadow: 0 0 0 62.4375rem rgba(0,0,0,0.7);
            animation: scanPulse 2s infinite;
        }

        .scan-overlay.scanning {
            border-color: var(--warning);
        }

        @@keyframes scanPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .scan-hint {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 0.875rem 1.5rem;
            border-radius: 1.5rem;
            font-size: 0.9375rem;
            max-width: 90%;
            text-align: center;
        }

        /* Responsive */
        @@media(min-width: 40em) {
            .guest-buttons {
                flex-direction: row;
            }

            .btn {
                min-width: 0;
            }
        }

        /* iOS Safe Areas */
        @@supports (-webkit-touch-callout: none) {
            .header {
                padding-top: max(0.75rem, env(safe-area-inset-top));
            }

            .content {
                padding-bottom: max(1rem, env(safe-area-inset-bottom));
            }

            .card,
            .guest-card {
                backdrop-filter: blur(0.9375rem) !important;
                -webkit-backdrop-filter: blur(0.9375rem) !important;
            }
        }
    </style>
}

<!-- Scan Page Content -->
<div class="scan-page">
    <!-- Class Info Badge -->
    <div class="class-info-badge">
        <div class="class-info-icon">
            <i class="fas fa-qrcode"></i>
        </div>
        <div class="class-info-text">
            <div class="class-info-title" id="claseNombre">Cargando clase...</div>
            <div class="class-info-name" id="claseHorario">Registro de Asistencia</div>
        </div>
        <div class="class-id-badge">#@ViewBag.ClaseId</div>
    </div>

    <!-- Instrucciones - Siempre visible -->
    <div class="instructions-card">
        <div class="instructions-header">
            <i class="fas fa-question-circle"></i>
            <span>¿Cómo registrar tu asistencia?</span>
        </div>
        <div class="instructions-list">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="instruction-item">
                    <div class="instruction-number">1</div>
                    <div class="instruction-content">
                        <div class="instruction-title">Registro Rápido (Recomendado)</div>
                        <div class="instruction-desc">Usa el botón "Registrar Mi Asistencia Ahora" para un registro instantáneo con tu cuenta.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="instruction-item">
                    <div class="instruction-number">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <div class="instruction-content">
                        <div class="instruction-title">Tip: Crea una cuenta</div>
                        <div class="instruction-desc">Con una cuenta puedes registrar tu asistencia con un solo clic. Usa el botón de menú para ingresar o registrarte.</div>
                    </div>
                </div>
            }
            <div class="instruction-item">
                <div class="instruction-number">
                    @if (User.Identity?.IsAuthenticated == true) { <text>2</text> } else { <text>1</text> }
                </div>
                <div class="instruction-content">
                    <div class="instruction-title">Escanear tu QR de Estudiante</div>
                    <div class="instruction-desc">Abre la cámara y escanea TU código QR de estudiante (formato EST123456).</div>
                </div>
            </div>
            <div class="instruction-item">
                <div class="instruction-number">
                    @if (User.Identity?.IsAuthenticated == true) { <text>3</text> } else { <text>2</text> }
                </div>
                <div class="instruction-content">
                    <div class="instruction-title">Registro Manual por Código</div>
                    <div class="instruction-desc">Ingresa tu código de estudiante (EST123456) manualmente en el formulario de abajo.</div>
                </div>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Usuario autenticado -->
        <div class="auth-badge">
            <div class="auth-avatar">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="auth-info">
                <div class="auth-name">@User.Identity.Name</div>
                <div class="auth-status">
                    <i class="fas fa-check-circle"></i>
                    Registro automático disponible
                </div>
            </div>
        </div>

        <!-- Registro Automático -->
        <div class="card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <div class="card-title">Registro Rápido</div>
            </div>
            <div class="card-desc">
                <i class="fas fa-info-circle"></i> Registra tu asistencia con un solo clic usando tu cuenta
            </div>
            <button class="btn btn-success" id="autoRegisterBtn">
                <i class="fas fa-fingerprint"></i>
                <span>Registrar Mi Asistencia Ahora</span>
            </button>
        </div>
    }

    <!-- Escanear QR -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">
                <i class="fas fa-camera"></i>
            </div>
            <div class="card-title">Escanear Código QR</div>
        </div>
        <div class="card-desc">
            <i class="fas fa-info-circle"></i> Abre la cámara y escanea TU código QR de estudiante para registrar tu asistencia
        </div>
        <button class="btn btn-primary" id="openCameraBtn">
            <i class="fas fa-qrcode"></i>
            <span>Abrir Cámara</span>
        </button>
    </div>

    <!-- Registro Manual -->
    <div class="card">
        <div class="card-header">
            <div class="card-icon">
                <i class="fas fa-keyboard"></i>
            </div>
            <div class="card-title">Registro Manual por Código</div>
        </div>
        <div class="card-desc">
            <i class="fas fa-info-circle"></i> Ingresa tu código de estudiante (EST123456) para registrar tu asistencia manualmente
        </div>
        <form id="manualForm">
            <div class="form-group">
                <label class="form-label" for="studentId">
                    <i class="fas fa-id-card"></i>
                    Código de Estudiante
                </label>
                <input
                    type="text"
                    id="studentId"
                    class="form-input"
                    placeholder="EST123456"
                    required
                    maxlength="9"
                    pattern="[Ee][Ss][Tt][0-9]{6}"
                    style="text-transform: uppercase;">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check-circle"></i>
                <span>Registrar Asistencia</span>
            </button>
        </form>
    </div>

    <!-- Messages -->
    <div id="messageArea"></div>
</div>

<!-- Camera Modal -->
<div class="camera-modal" id="cameraModal">
    <div class="camera-header">
        <div class="camera-title">
            <i class="fas fa-qrcode"></i>
            Escanear QR
        </div>
        <button class="close-camera" id="closeCameraBtn">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="camera-viewport">
        <video id="videoElement" playsinline autoplay></video>
        <div class="scan-overlay" id="scanOverlay"></div>
        <div class="scan-hint">
            <i class="fas fa-arrow-down"></i> Centra el código QR en el recuadro
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/qr-scanner@1.4.2/qr-scanner.umd.min.js"></script>
    <script>
        const claseId = @ViewBag.ClaseId;
        let currentNonce = "@ViewBag.Nonce";
        let qrScanner = null;
        let isProcessing = false;
        let lastRegisteredCode = null;

        // Cache local para evitar duplicados en la misma sesión
        const CACHE_KEY = `asistencia_${claseId}_${currentNonce}`;

        // Verificar si ya se registró en esta sesión
        function yaSeRegistro(codigo) {
            const cached = sessionStorage.getItem(CACHE_KEY);
            return cached === codigo;
        }

        // Guardar registro en cache
        function guardarEnCache(codigo) {
            sessionStorage.setItem(CACHE_KEY, codigo);
            lastRegisteredCode = codigo;
        }

        // Helper para iconos de estado
        function getEstadoIcon(estado) {
            const icons = {
                'Presente': '<i class="fas fa-check-circle icon-presente"></i>',
                'Tardanza': '<i class="fas fa-clock icon-tardanza"></i>',
                'Ausente': '<i class="fas fa-times-circle icon-ausente"></i>',
                'Justificado': '<i class="fas fa-file-medical icon-justificado"></i>'
            };
            return icons[estado] || '<i class="fas fa-check-circle icon-success"></i>';
        }

        // Cargar info clase
        async function loadClassInfo() {
            try {
                // Usar endpoint público que no requiere autenticación
                const res = await fetch(`/api/clases/public/${claseId}`);
                if (res.ok) {
                    const data = await res.json();
                    // Construir nombre completo: Nombre de Clase - Ramo (Curso)
                    let name = '';

                    if (data.asignatura) {
                        name = data.asignatura;
                    }

                    // Agregar información del ramo si existe
                    if (data.ramo && data.ramo.nombre) {
                        if (name) name += ' - ';
                        name += data.ramo.nombre;

                        // Agregar curso si existe
                        if (data.ramo.curso && data.ramo.curso.nombre) {
                            name += ` (${data.ramo.curso.nombre})`;
                        }
                    }

                    // Fallback si no hay información
                    if (!name) {
                        name = `Clase ${claseId}`;
                    }

                    document.getElementById('claseNombre').textContent = name;

                    // Mostrar horario de la clase
                    if (data.inicioUtc) {
                        const inicio = new Date(data.inicioUtc);
                        const horaInicio = inicio.toLocaleTimeString('es-CL', {
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: false
                        });

                        let horarioText = `<i class="fas fa-clock"></i> ${horaInicio}`;

                        if (data.finUtc) {
                            const fin = new Date(data.finUtc);
                            const horaFin = fin.toLocaleTimeString('es-CL', {
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: false
                            });
                            horarioText += ` - ${horaFin}`;

                            // Verificar si la clase está activa o ya terminó
                            const ahora = new Date();
                            if (ahora < fin) {
                                horarioText += ' <span style="color: var(--success); font-weight: 600;">(Activa)</span>';
                            } else {
                                horarioText += ' <span style="color: var(--text-muted); font-weight: 600;">(Finalizada)</span>';
                            }
                        } else {
                            horarioText += ' - <span style="color: var(--success); font-weight: 600;">En curso</span>';
                        }

                        document.getElementById('claseHorario').innerHTML = horarioText;
                    }
                }
            } catch (e) {
                document.getElementById('claseNombre').textContent = `Clase ${claseId}`;
                document.getElementById('claseHorario').textContent = 'Registro de Asistencia';
            }
        }

        // Mostrar mensaje con animación
        function showMessage(text, type = 'error', autoHide = true, duration = null) {
            const area = document.getElementById('messageArea');
            const icons = {
                success: 'check-circle',
                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle',
                loading: 'spinner fa-spin'
            };

            // Duración por defecto según tipo
            if (!duration) {
                duration = type === 'success' ? 8000 : // Éxito: 8 segundos
                          type === 'error' ? 6000 :   // Error: 6 segundos
                          type === 'warning' ? 7000 : // Warning: 7 segundos
                          5000;                       // Otros: 5 segundos
            }

            area.innerHTML = `
                <div class="message message-${type}" style="animation: slideIn 0.3s ease-out;">
                    <i class="fas fa-${icons[type] || icons.info}"></i>
                    <div class="message-text">${text}</div>
                </div>
            `;

            // Scroll suave al mensaje
            area.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            // Auto-ocultar después del tiempo especificado (excepto loading)
            if (autoHide && type !== 'loading') {
                setTimeout(() => {
                    const msg = area.querySelector('.message');
                    if (msg) {
                        msg.style.animation = 'slideOut 0.3s ease-out';
                        setTimeout(() => area.innerHTML = '', 300);
                    }
                }, duration);
            }
        }

        // Limpiar mensajes
        function clearMessages() {
            document.getElementById('messageArea').innerHTML = '';
        }

        // Registro manual con optimizaciones
        document.getElementById('manualForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            // Evitar doble submit
            if (isProcessing) {
                showMessage('<i class="fas fa-hourglass-half icon-warning"></i> Procesando... por favor espera', 'warning');
                return;
            }

            const codigoAlumno = document.getElementById('studentId').value.trim().toUpperCase();

            // Validar formato EST123456
            if (!/^EST\d{6}$/.test(codigoAlumno)) {
                showMessage('[ERROR] Formato inválido. Debe ser EST seguido de 6 dígitos (Ej: EST123456)', 'error');
                return;
            }

            // Verificar cache local primero
            if (yaSeRegistro(codigoAlumno)) {
                showMessage(`[OK] Ya registraste tu asistencia con el código ${codigoAlumno} en esta sesión`, 'success');
                return;
            }

            isProcessing = true;
            const submitBtn = e.target.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Registrando...</span>';

            // Mostrar mensaje de loading
            showMessage('⏳ Registrando tu asistencia...', 'loading', false);

            try {
                const startTime = Date.now();

                const res = await fetch('/api/asistencias/alumno-scan-codigo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        codigoAlumno: codigoAlumno,
                        claseId,
                        nonce: currentNonce
                    })
                });

                const data = await res.json();
                const elapsed = Date.now() - startTime;

                // Mínimo de 500ms para que se vea el feedback
                if (elapsed < 500) {
                    await new Promise(resolve => setTimeout(resolve, 500 - elapsed));
                }

                if (res.ok) {
                    // Guardar en cache
                    guardarEnCache(codigoAlumno);

                    const estado = data.estudiante?.estado || 'Registrado';
                    const nombre = data.estudiante?.nombre || '';
                    const icon = getEstadoIcon(estado);

                    showMessage(
                        `${icon} <strong>¡Asistencia registrada!</strong><br>` +
                        `${nombre ? `Estudiante: ${nombre}<br>` : ''}` +
                        `Código: ${codigoAlumno}<br>` +
                        `Estado: <strong>${estado}</strong>`,
                        'success'
                    );

                    document.getElementById('manualForm').reset();
                } else {
                    throw new Error(data.mensaje || 'Error al registrar asistencia');
                }
            } catch (error) {
                let msg = error.message;
                let type = 'error';

                // Mensajes optimizados
                if (msg.includes('ya ha sido registrada') || msg.includes('ya registrada')) {
                    msg = '<i class="fas fa-check-circle icon-success"></i> Tu asistencia ya fue registrada anteriormente';
                    type = 'success';
                    guardarEnCache(codigoAlumno); // Guardar en cache también
                } else if (msg.includes('no encontrado')) {
                    msg = '<i class="fas fa-times-circle icon-error"></i> Código no encontrado. Verifica que sea correcto (EST123456)';
                } else if (msg.includes('no activa') || msg.includes('no está activa')) {
                    msg = '<i class="fas fa-exclamation-triangle icon-warning"></i> Esta clase no está activa en este momento';
                    type = 'warning';
                } else if (msg.includes('expirado') || msg.includes('vencido')) {
                    msg = '<i class="fas fa-hourglass-end icon-warning"></i> El código QR ha expirado. Solicita uno nuevo al profesor';
                    type = 'warning';
                } else if (msg.includes('dispositivo') || msg.includes('ya se registró') ||
                          msg.toLowerCase().includes('ya no se puede') ||
                          msg.toLowerCase().includes('personal')) {
                    msg = '<i class="fas fa-ban icon-warning"></i> <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          '<small><i class="fas fa-lightbulb"></i> Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else if (msg.toLowerCase().includes('error al registrar') && lastRegisteredCode) {
                    msg = '<i class="fas fa-ban icon-warning"></i> <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          '<small><i class="fas fa-lightbulb"></i> Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else {
                    msg = `<i class="fas fa-times-circle icon-error"></i> ${msg}`;
                }

                showMessage(msg, type);
            } finally {
                isProcessing = false;
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }
        });

        // Registro automático con optimizaciones
        document.getElementById('autoRegisterBtn')?.addEventListener('click', async function() {
            if (isProcessing) {
                showMessage('⏳ Procesando... por favor espera', 'warning');
                return;
            }

            // Verificar cache (usando username como código)
            const username = '@User.Identity?.Name';
            if (yaSeRegistro(username)) {
                showMessage(`[OK] Ya registraste tu asistencia en esta sesión`, 'success');
                return;
            }

            isProcessing = true;
            const btn = this;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Registrando...</span>';

            showMessage('⏳ Registrando tu asistencia automáticamente...', 'loading', false);

            try {
                const startTime = Date.now();

                const res = await fetch('/api/asistencias/alumno-scan-auto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ claseId, nonce: currentNonce })
                });

                const data = await res.json();
                const elapsed = Date.now() - startTime;

                if (elapsed < 500) {
                    await new Promise(resolve => setTimeout(resolve, 500 - elapsed));
                }

                if (res.ok) {
                    guardarEnCache(username);

                    const estado = data.estudiante?.estado || 'Registrado';
                    const icon = estado === 'Presente' ? '[OK]' :
                                 estado === 'Tardanza' ? '[TIME]' : '[ERROR]';

                    showMessage(
                        `${icon} <strong>¡Asistencia registrada automáticamente!</strong><br>` +
                        `Usuario: ${username}<br>` +
                        `Estado: <strong>${estado}</strong>`,
                        'success'
                    );
                } else {
                    throw new Error(data.mensaje || 'Error al registrar');
                }
            } catch (error) {
                let msg = error.message;
                let type = 'error';

                if (msg.includes('ya ha sido registrada') || msg.includes('ya registrada')) {
                    msg = '[OK] Tu asistencia ya fue registrada anteriormente';
                    type = 'success';
                    guardarEnCache(username);
                } else if (msg.includes('no activa')) {
                    msg = '[WARNING] Esta clase no está activa en este momento';
                    type = 'warning';
                } else if (msg.includes('expirado')) {
                    msg = '⏱️ El código QR ha expirado. Solicita uno nuevo al profesor';
                    type = 'warning';
                } else if (msg.includes('dispositivo') || msg.includes('ya se registró') ||
                          msg.toLowerCase().includes('ya no se puede') ||
                          msg.toLowerCase().includes('personal')) {
                    msg = '🚫 <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          '<small>💡 Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else if (msg.toLowerCase().includes('error al registrar') && lastRegisteredCode) {
                    msg = '🚫 <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          '<small>💡 Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else {
                    msg = `[ERROR] ${msg}`;
                }

                showMessage(msg, type);
            } finally {
                isProcessing = false;
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        // Cámara QR
        const modal = document.getElementById('cameraModal');
        const video = document.getElementById('videoElement');
        const overlay = document.getElementById('scanOverlay');

        document.getElementById('openCameraBtn').addEventListener('click', async () => {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment' }
                });
                video.srcObject = stream;
                modal.classList.add('active');
                startScanning();
            } catch (error) {
                showMessage('[ERROR] No se pudo acceder a la cámara. Verifica los permisos.', 'error');
            }
        });

        document.getElementById('closeCameraBtn').addEventListener('click', () => {
            closeCamera();
        });

        function closeCamera() {
            if (qrScanner) {
                qrScanner.stop();
                qrScanner = null;
            }
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
            modal.classList.remove('active');
        }

        function startScanning() {
            overlay.classList.add('scanning');
            qrScanner = new QrScanner(
                video,
                result => handleQRCode(result.data),
                {
                    onDecodeError: () => {},
                    highlightScanRegion: false,
                    highlightCodeOutline: false,
                    maxScansPerSecond: 5
                }
            );
            qrScanner.start();
        }

        // Extraer código de estudiante del QR
        function extractCodigo(qrData) {
            // Formato directo EST123456
            if (/^EST\d{6}$/i.test(qrData)) return qrData.toUpperCase();

            // Formato JSON
            try {
                if (qrData.startsWith('{')) {
                    const data = JSON.parse(qrData);
                    return data.studentCode || data.codigo || data.code;
                }
            } catch (e) {}

            // Buscar patrón EST123456 en el texto
            const match = qrData.match(/EST\d{6}/i);
            return match ? match[0].toUpperCase() : null;
        }

        async function handleQRCode(data) {
            // Evitar procesar si ya está procesando
            if (isProcessing) {
                return;
            }

            overlay.classList.remove('scanning');
            closeCamera();

            // Extraer código de estudiante del QR escaneado
            const codigoAlumno = extractCodigo(data);

            if (!codigoAlumno) {
                showMessage('[WARNING] Código QR no válido. Asegúrate de escanear tu QR de estudiante (formato EST123456)', 'warning');
                return;
            }

            // Verificar cache inmediatamente
            if (yaSeRegistro(codigoAlumno)) {
                showMessage(`[OK] Ya registraste tu asistencia con el código ${codigoAlumno} en esta sesión`, 'success');
                return;
            }

            // Llenar el input con el código escaneado
            document.getElementById('studentId').value = codigoAlumno;

            isProcessing = true;

            // Feedback inmediato - UI Optimista
            showMessage(`⏳ Registrando ${codigoAlumno}...`, 'loading', false);

            // Registrar asistencia con el código escaneado
            try {
                const startTime = Date.now();

                const res = await fetch('/api/asistencias/alumno-scan-codigo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        codigoAlumno: codigoAlumno,
                        claseId,
                        nonce: currentNonce
                    })
                });

                const result = await res.json();
                const elapsed = Date.now() - startTime;

                // Mínimo 400ms para feedback visual
                if (elapsed < 400) {
                    await new Promise(resolve => setTimeout(resolve, 400 - elapsed));
                }

                if (res.ok) {
                    // Guardar en cache
                    guardarEnCache(codigoAlumno);

                    const estado = result.estudiante?.estado || 'Registrado';
                    const nombre = result.estudiante?.nombre || '';
                    const icon = estado === 'Presente' ? '[OK]' :
                                 estado === 'Tardanza' ? '[TIME]' : '[ERROR]';

                    showMessage(
                        `${icon} <strong>¡Asistencia registrada por QR!</strong><br>` +
                        `${nombre ? `Estudiante: ${nombre}<br>` : ''}` +
                        `Código: ${codigoAlumno}<br>` +
                        `Estado: <strong>${estado}</strong>`,
                        'success'
                    );

                    // Vibrar para feedback háptico (si está disponible)
                    if (navigator.vibrate) {
                        navigator.vibrate([100, 50, 100]);
                    }
                } else {
                    throw new Error(result.mensaje || 'Error al registrar');
                }
            } catch (error) {
                let msg = error.message;
                let type = 'error';

                // Mensajes optimizados y específicos
                if (msg.includes('ya ha sido registrada') || msg.includes('ya registrada')) {
                    msg = `[OK] Tu asistencia ya fue registrada con ${codigoAlumno}`;
                    type = 'success';
                    guardarEnCache(codigoAlumno);
                } else if (msg.includes('no encontrado')) {
                    msg = `[ERROR] El código ${codigoAlumno} no existe en el sistema`;
                } else if (msg.includes('no activa')) {
                    msg = '[WARNING] Esta clase no está activa actualmente';
                    type = 'warning';
                } else if (msg.includes('expirado') || msg.includes('vencido')) {
                    msg = '⏱️ El código QR ha expirado. Pide uno nuevo al profesor';
                    type = 'warning';
                } else if (msg.includes('dispositivo') || msg.includes('ya se registró') ||
                          msg.toLowerCase().includes('ya no se puede') ||
                          msg.toLowerCase().includes('personal')) {
                    msg = '🚫 <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          `<small>Código escaneado: ${codigoAlumno}</small><br>` +
                          '<small>💡 Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else if (msg.toLowerCase().includes('error al registrar') && lastRegisteredCode) {
                    msg = '🚫 <strong>Ya se registró una asistencia desde este dispositivo</strong><br>' +
                          'El registro es personal. No puedes registrar a otro estudiante desde aquí.<br>' +
                          `<small>Ya registrado: ${lastRegisteredCode} | Intentaste: ${codigoAlumno}</small><br>` +
                          '<small>💡 Si eres tú, pide al docente que escanee tu QR físico para registrarte.</small>';
                    type = 'warning';
                } else {
                    msg = `[ERROR] ${msg}`;
                }

                showMessage(msg, type);

                // Vibrar error
                if (navigator.vibrate && type === 'error') {
                    navigator.vibrate(200);
                }
            } finally {
                isProcessing = false;
            }
        }

        // Validación en tiempo real del input
        const studentIdInput = document.getElementById('studentId');
        studentIdInput?.addEventListener('input', (e) => {
            let value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            e.target.value = value;

            // Validar formato completo EST123456
            const valid = /^EST\d{6}$/.test(value);
            const partial = /^(E|ES|EST|EST\d{1,5})$/.test(value);

            e.target.classList.remove('valid', 'invalid');
            if (valid) {
                e.target.style.borderColor = 'hsl(142, 71%, 45%)';
                e.target.style.boxShadow = '0 0 0 0.25rem hsla(142, 71%, 45%, 0.15)';
            } else if (value && !partial) {
                e.target.style.borderColor = 'hsl(0, 84%, 60%)';
                e.target.style.boxShadow = '0 0 0 0.25rem hsla(0, 84%, 60%, 0.15)';
            } else {
                e.target.style.borderColor = '';
                e.target.style.boxShadow = '';
            }
        });

        // Inicializar
        loadClassInfo();
    </script>
}
