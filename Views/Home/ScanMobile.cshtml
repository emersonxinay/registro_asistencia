<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#667eea">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <title>Registrar Asistencia</title>

    <!-- Theme System CSS -->
    <link href="~/css/theme-system.css" rel="stylesheet" />

    <!-- Theme Initialization Script -->
    <script>
        (function() {
            const theme = localStorage.getItem('user-theme-preference') ||
                         (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.classList.add('theme-loading');
        })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --primary: #667eea;
            --primary-dark: #5a67d8;
            --success: #10b981;
            --error: #ef4444;
            --warning: #f59e0b;
            --bg: #f8f9fa;
            --text: #1f2937;
            --text-light: #6b7280;
            --border: #e5e7eb;
        }

        html, body {
            height: 100%;
            height: 100dvh;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--primary) 0%, #764ba2 100%);
            touch-action: pan-y;
            overscroll-behavior: none;
            position: fixed;
            width: 100%;
        }

        .app {
            display: flex;
            flex-direction: column;
            height: 100%;
            height: 100dvh;
            position: relative;
        }

        /* Compact Header - Fixed */
        .header {
            flex-shrink: 0;
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(10px);
            padding: max(env(safe-area-inset-top), 12px) 16px 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            position: relative;
            z-index: 100;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--primary), #764ba2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .header-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
        }

        .header-subtitle {
            font-size: 11px;
            color: var(--text-light);
        }

        .class-badge {
            background: linear-gradient(135deg, var(--primary), #764ba2);
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        /* Main Content - Scrollable */
        .content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 16px;
            padding-bottom: max(env(safe-area-inset-bottom), 16px);
        }

        .content::-webkit-scrollbar {
            display: none;
        }

        /* Action Cards - Compact */
        .action-card {
            background: white;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .card-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
        }

        /* Button Primary */
        .btn-primary {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, var(--primary), #764ba2);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            transition: transform 0.2s;
            min-height: 50px;
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        .btn-primary:disabled {
            background: #cbd5e1;
            box-shadow: none;
        }

        .btn-secondary {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15);
        }

        /* Camera View - Full Coverage */
        .camera-container {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #000;
            z-index: 200;
        }

        .camera-container.active {
            display: flex;
            flex-direction: column;
        }

        .camera-header {
            flex-shrink: 0;
            padding: max(env(safe-area-inset-top), 12px) 16px 12px;
            background: rgba(0,0,0,0.8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .camera-title {
            font-size: 16px;
            font-weight: 600;
        }

        .close-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .camera-view-wrapper {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #cameraView {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        #cameraCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
        }

        .scan-frame {
            position: absolute;
            width: 240px;
            height: 240px;
            border: 3px solid var(--success);
            border-radius: 20px;
            box-shadow: 0 0 0 9999px rgba(0,0,0,0.6);
        }

        .scan-frame.scanning {
            border-color: var(--warning);
            animation: pulse 1.5s infinite;
        }

        .scan-frame.found {
            border-color: var(--success);
            animation: success-flash 0.5s;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        @@keyframes success-flash {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .scan-line {
            position: absolute;
            width: 220px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--warning), transparent);
            animation: scan-sweep 2s linear infinite;
        }

        @@keyframes scan-sweep {
            0% { transform: translateY(-110px); }
            100% { transform: translateY(110px); }
        }

        .camera-status {
            flex-shrink: 0;
            padding: 16px;
            background: rgba(0,0,0,0.9);
            color: white;
            text-align: center;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 14px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--warning);
            animation: blink 1.5s infinite;
        }

        .status-dot.success {
            background: var(--success);
            animation: none;
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* Form Input */
        .input-group {
            margin-bottom: 16px;
        }

        .input-label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 18px;
            color: var(--text-light);
        }

        .text-input {
            width: 100%;
            padding: 14px 16px 14px 50px;
            border: 2px solid var(--border);
            border-radius: 12px;
            font-size: 16px;
            font-weight: 500;
            background: white;
            transition: border-color 0.2s;
        }

        .text-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .text-input.valid {
            border-color: var(--success);
        }

        .text-input.invalid {
            border-color: var(--error);
        }

        /* Messages */
        .message {
            padding: 14px 16px;
            border-radius: 12px;
            margin-bottom: 12px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .message.success {
            background: rgba(16, 185, 129, 0.1);
            color: #065f46;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .message.error {
            background: rgba(239, 68, 68, 0.1);
            color: #991b1b;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .message.warning {
            background: rgba(245, 158, 11, 0.1);
            color: #92400e;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .message-icon {
            flex-shrink: 0;
            font-size: 18px;
        }

        /* Loading Spinner */
        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Utilities */
        .hidden {
            display: none !important;
        }

        .text-center {
            text-align: center;
        }

        .text-sm {
            font-size: 13px;
            color: var(--text-light);
        }

        .mt-1 {
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <div class="app">
        <!-- Compact Fixed Header -->
        <header class="header">
            <div class="header-content">
                <div class="header-left">
                    <div class="app-icon">📱</div>
                    <div>
                        <div class="header-title">Registro de Asistencia</div>
                        <div class="header-subtitle">Escanea o ingresa tu código</div>
                    </div>
                </div>
                <div class="class-badge">#@ViewBag.ClaseId</div>
            </div>
        </header>

        <!-- Scrollable Content -->
        <div class="content">
            <!-- Message Container -->
            <div id="messageContainer"></div>

            <!-- Scanner Card -->
            <div class="action-card">
                <div class="card-header">
                    <div class="card-icon">📸</div>
                    <div class="card-title">Opción 1: Escanear QR</div>
                </div>
                <button type="button" class="btn-primary" id="startScanBtn">
                    <span>📱</span>
                    <span>Abrir Cámara</span>
                </button>
                <p class="text-sm text-center mt-1">Escanea tu código QR de estudiante</p>
            </div>

            <!-- Manual Input Card -->
            <div class="action-card">
                <div class="card-header">
                    <div class="card-icon">✏️</div>
                    <div class="card-title">Opción 2: Ingreso Manual</div>
                </div>
                <form id="scanForm">
                    <div class="input-group">
                        <label class="input-label" for="codigoAlumno">Código de Estudiante</label>
                        <div class="input-wrapper">
                            <span class="input-icon">👤</span>
                            <input
                                type="text"
                                id="codigoAlumno"
                                class="text-input"
                                placeholder="EST000001"
                                pattern="[Ee][Ss][Tt][0-9]{6}"
                                maxlength="9"
                                autocomplete="off"
                                style="text-transform: uppercase;"
                                required>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary" id="submitBtn">
                        <span>✅</span>
                        <span>Registrar Asistencia</span>
                    </button>
                    <button type="button" class="btn-primary hidden" id="loadingBtn" disabled>
                        <div class="spinner"></div>
                        <span>Registrando...</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Full-Screen Camera View -->
        <div class="camera-container" id="cameraContainer">
            <div class="camera-header">
                <div class="camera-title">Escaneando Código QR</div>
                <button type="button" class="close-btn" id="closeCamera">✕</button>
            </div>
            <div class="camera-view-wrapper">
                <video id="cameraView" autoplay playsinline muted></video>
                <canvas id="cameraCanvas"></canvas>
                <div class="scan-frame scanning" id="scanFrame">
                    <div class="scan-line"></div>
                </div>
            </div>
            <div class="camera-status">
                <div class="status-indicator" id="scanStatus">
                    <div class="status-dot"></div>
                    <span>Buscando código QR...</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        const claseId = @ViewBag.ClaseId;
        const currentNonce = '@ViewBag.Nonce';
        let isSubmitting = false;
        let stream = null;
        let isScanning = false;
        let scanningInterval = null;

        // Elements
        const startScanBtn = document.getElementById('startScanBtn');
        const closeCamera = document.getElementById('closeCamera');
        const cameraContainer = document.getElementById('cameraContainer');
        const cameraView = document.getElementById('cameraView');
        const cameraCanvas = document.getElementById('cameraCanvas');
        const scanFrame = document.getElementById('scanFrame');
        const scanStatus = document.getElementById('scanStatus');
        const form = document.getElementById('scanForm');
        const submitBtn = document.getElementById('submitBtn');
        const loadingBtn = document.getElementById('loadingBtn');
        const codigoInput = document.getElementById('codigoAlumno');
        const messageContainer = document.getElementById('messageContainer');

        // Start Scanner
        startScanBtn.addEventListener('click', startCamera);
        closeCamera.addEventListener('click', stopCamera);

        async function startCamera() {
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
                });

                cameraView.srcObject = stream;
                cameraContainer.classList.add('active');

                await new Promise(resolve => {
                    cameraView.onloadedmetadata = () => {
                        cameraView.play();
                        resolve();
                    };
                });

                const canvas = cameraCanvas;
                const context = canvas.getContext('2d');
                canvas.width = cameraView.videoWidth;
                canvas.height = cameraView.videoHeight;

                isScanning = true;
                showMessage('📸 Cámara activada. Apunta hacia tu código QR.', 'success');

                scanningInterval = setInterval(() => {
                    if (cameraView.readyState === cameraView.HAVE_ENOUGH_DATA) {
                        scanForQR(context, canvas);
                    }
                }, 100);

            } catch (error) {
                console.error('Camera error:', error);
                showMessage('❌ No se pudo acceder a la cámara. Verifica los permisos.', 'error');
            }
        }

        function stopCamera() {
            isScanning = false;
            if (scanningInterval) clearInterval(scanningInterval);
            if (stream) stream.getTracks().forEach(track => track.stop());
            cameraContainer.classList.remove('active');
            scanFrame.classList.remove('scanning', 'found');
        }

        function scanForQR(context, canvas) {
            if (!isScanning) return;

            try {
                context.drawImage(cameraView, 0, 0, canvas.width, canvas.height);
                const imageData = context.getImageData(0, 0, canvas.width, canvas.height);
                const qrCode = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: "dontInvert",
                });

                if (qrCode) {
                    onQRFound(qrCode.data);
                }
            } catch (error) {
                console.error('Scan error:', error);
            }
        }

        function onQRFound(qrData) {
            if (!isScanning) return;

            scanFrame.classList.remove('scanning');
            scanFrame.classList.add('found');
            updateScanStatus('¡Código detectado!', true);

            try {
                navigator.vibrate && navigator.vibrate([100, 50, 100]);
            } catch (e) {}

            const codigo = extractCodigo(qrData);
            if (codigo) {
                stopCamera();
                codigoInput.value = codigo;
                submitAttendance(codigo);
            } else {
                setTimeout(() => {
                    scanFrame.classList.remove('found');
                    scanFrame.classList.add('scanning');
                    updateScanStatus('Código no válido. Usa tu QR de estudiante.', false);
                }, 1500);
            }
        }

        function extractCodigo(qrData) {
            if (/^EST\d{6}$/i.test(qrData)) return qrData.toUpperCase();

            try {
                if (qrData.startsWith('{')) {
                    const data = JSON.parse(qrData);
                    return data.studentCode || data.codigo || data.code;
                }
            } catch (e) {}

            const match = qrData.match(/EST\d{6}/i);
            return match ? match[0].toUpperCase() : null;
        }

        function updateScanStatus(text, success) {
            const indicator = scanStatus.querySelector('.status-indicator span');
            const dot = scanStatus.querySelector('.status-dot');
            indicator.textContent = text;
            dot.classList.toggle('success', success);
        }

        // Form Submission
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const codigo = codigoInput.value.trim().toUpperCase();

            if (!/^EST\d{6}$/.test(codigo)) {
                showMessage('❌ Formato inválido. Debe ser EST seguido de 6 dígitos.', 'error');
                return;
            }

            await submitAttendance(codigo);
        });

        async function submitAttendance(codigo) {
            if (isSubmitting) return;

            const sessionKey = `clase_${claseId}_registered`;
            if (sessionStorage.getItem(sessionKey)) {
                showMessage('⚠️ Ya registraste tu asistencia en esta sesión.', 'warning');
                return;
            }

            isSubmitting = true;
            submitBtn.classList.add('hidden');
            loadingBtn.classList.remove('hidden');

            try {
                const response = await fetch('/api/asistencias/alumno-scan-codigo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ codigoAlumno: codigo, claseId, nonce: currentNonce })
                });

                const result = await response.json();

                if (response.ok) {
                    sessionStorage.setItem(sessionKey, codigo);
                    const estado = result.estudiante?.estado || 'Registrado';
                    const emoji = estado === 'Presente' ? '✅' : estado === 'Tardanza' ? '⏰' : '❌';
                    showMessage(`${emoji} ${result.mensaje}<br><strong>Estado:</strong> ${estado}`, 'success');
                    form.reset();
                } else {
                    throw new Error(result.message || result.mensaje || 'Error al registrar');
                }

            } catch (error) {
                let msg = error.message;
                if (msg.includes('no encontrado')) msg = 'Código no encontrado. Verifica tu código.';
                else if (msg.includes('no activa')) msg = 'Clase no activa. Contacta al profesor.';
                else if (msg.includes('expirado')) msg = 'Enlace expirado. Solicita nuevo código al profesor.';
                showMessage('❌ ' + msg, 'error');
            } finally {
                isSubmitting = false;
                submitBtn.classList.remove('hidden');
                loadingBtn.classList.add('hidden');
            }
        }

        function showMessage(html, type) {
            const icons = { success: '✅', error: '❌', warning: '⚠️' };
            messageContainer.innerHTML = `
                <div class="message ${type}">
                    <span class="message-icon">${icons[type]}</span>
                    <div>${html}</div>
                </div>
            `;
            messageContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Input Validation
        codigoInput.addEventListener('input', (e) => {
            const value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            e.target.value = value;

            const valid = /^EST\d{6}$/.test(value);
            const partial = /^(E|ES|EST|EST\d{1,5})$/.test(value);

            e.target.classList.remove('valid', 'invalid');
            if (valid) e.target.classList.add('valid');
            else if (value && !partial) e.target.classList.add('invalid');
        });

        // Cleanup
        window.addEventListener('beforeunload', () => {
            if (stream) stream.getTracks().forEach(track => track.stop());
        });

        // Initial message
        setTimeout(() => {
            showMessage('👋 Elige tu método preferido para registrar tu asistencia.', 'success');
        }, 800);

        console.log('📱 Registro móvil cargado - Clase:', claseId);
    </script>

    <!-- Theme Manager Script -->
    <script src="~/js/theme-manager.js"></script>
</body>
</html>
