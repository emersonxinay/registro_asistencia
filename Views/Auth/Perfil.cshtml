@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mi Perfil";
}

@section Styles {
    <link href="~/css/perfil.css" rel="stylesheet" />
}

<div class="perfil-container">
    <div class="perfil-header">
        <div class="header-content">
            <div class="icon-container">
                <i class="fas fa-user-circle"></i>
            </div>
            <div class="header-info">
                <h1>Mi Perfil</h1>
                <p class="subtitle">Información de la cuenta</p>
            </div>
        </div>
    </div>

    <div class="perfil-content">
        <div class="perfil-card">
            <div class="card-header">
                <h3><i class="fas fa-id-card"></i> Información Personal</h3>
                <a href="/perfil/editar" class="btn-edit">
                    <i class="fas fa-edit"></i> Editar
                </a>
            </div>
            <div class="card-body">
                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-user"></i>
                        <span>Nombre</span>
                    </div>
                    <div class="info-value">
                        @User.Identity?.Name
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-envelope"></i>
                        <span>Email</span>
                    </div>
                    <div class="info-value">
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-id-badge"></i>
                        <span>Código Docente</span>
                    </div>
                    <div class="info-value">
                        @User.FindFirst("CodigoDocente")?.Value
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-building"></i>
                        <span>Departamento</span>
                    </div>
                    <div class="info-value">
                        @(User.FindFirst("Departamento")?.Value ?? "No especificado")
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-shield-alt"></i>
                        <span>Rol</span>
                    </div>
                    <div class="info-value">
                        <span class="role-badge @(User.IsInRole("Admin") ? "admin" : "docente")">
                            @(User.IsInRole("Admin") ? "Administrador" : "Docente")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="perfil-actions">
            <div class="action-card">
                <div class="card-header">
                    <h3><i class="fas fa-cog"></i> Acciones</h3>
                </div>
                <div class="card-body">
                    <div class="action-buttons">
                        <a href="@Url.Action("Dashboard", "Docente")" class="btn btn-primary">
                            <i class="fas fa-tachometer-alt"></i>
                            Ir al Dashboard
                        </a>
                        <a href="@Url.Action("Cursos", "Docente")" class="btn btn-secondary">
                            <i class="fas fa-graduation-cap"></i>
                            Mis Cursos
                        </a>
                        <form method="post" action="@Url.Action("Logout", "Auth")" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-sign-out-alt"></i>
                                Cerrar Sesión
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" id="successAlert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" id="errorAlert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-ocultar alertas después de 5 segundos
            setTimeout(function() {
                const successAlert = document.getElementById('successAlert');
                const errorAlert = document.getElementById('errorAlert');
                if (successAlert) successAlert.remove();
                if (errorAlert) errorAlert.remove();
            }, 5000);
        });
    </script>
}